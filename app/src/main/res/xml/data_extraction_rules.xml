<?xml version="1.0" encoding="utf-8"?><!--
   Что Android 12+ может унести из приложения: облачный бэкап и перенос на новое устройство.

   Не уносится ничего. На Android 12+ allowBackup="false" отключает только облачный бэкап, а
   перенос между устройствами (device-transfer) продолжает работать — поэтому исключения записаны
   явно для обоих случаев:
   - база зашифрована ключом, который завёрнут ключом Android Keystore, а ключи Keystore на новое
     устройство не переезжают: перенесённая база там нечитаема и выглядела бы как потеря ключа;
   - токены и хеш PIN зашифрованы так же — на новом устройстве они бесполезны;
   - данные залогиненного пользователя и так вернутся с сервера после входа.
   Набор ключей базы лежит в noBackupFilesDir, который система не уносит никогда.
   Подробности — docs/encryption.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
