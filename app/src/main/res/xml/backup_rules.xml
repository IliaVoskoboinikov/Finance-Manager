<?xml version="1.0" encoding="utf-8"?><!--
   Правила бэкапа для Android 11 и ниже (на 12+ действует data_extraction_rules.xml).

   Бэкап отключён (allowBackup="false"), но исключения записаны явно — на случай, если флаг
   когда-нибудь включат: зашифрованная база без ключей Keystore на другом устройстве бесполезна,
   а зашифрованные токены и хеш PIN там не расшифровать. Подробности — docs/encryption.md.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
